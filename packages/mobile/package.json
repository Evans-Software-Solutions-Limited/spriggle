{
  "name": "@spriggle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests --coverage",
    "e2e:build": "detox build --configuration ios.sim.debug",
    "e2e:test": "detox test --configuration ios.sim.debug --cleanup",
    "e2e:build:release": "detox build --configuration ios.sim.release",
    "e2e:test:release": "detox test --configuration ios.sim.release --cleanup",
    "build": "echo 'Mobile build handled by EAS'"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@spriggle/engine": "workspace:*",
    "@tamagui/animations-react-native": "^2.0.0-rc.40",
    "@tamagui/babel-plugin": "^2.0.0-rc.40",
    "@tamagui/core": "^2.0.0-rc.40",
    "@tanstack/react-query": "^5.62.0",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.13",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.8",
    "expo-game-center": "^1.0.1",
    "expo-haptics": "~55.0.15",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.15",
    "expo-splash-screen": "~55.0.18",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "2.31.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@jest/reporters": "29.7.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.8",
    "detox": "^20.51.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "jest-circus": "29.7.0",
    "jest-environment-node": "29.7.0",
    "jest-expo": "~55.0.16",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.bun/[^/]+/node_modules/)?(react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|native-base|react-native-svg|react-native-reanimated|react-native-worklets|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|expo-modules-core)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    }
  }
}
